# drizzle
# NOTE: drizzle/meta/ is intentionally NOT gitignored. It contains the
# migration journal and schema snapshots required for `db:generate` to
# produce incremental migrations. Line endings are forced to LF via
# .gitattributes to keep migration hashes consistent across platforms.

# editor
.vscode/*
!.vscode/extensions.json
.idea

# Windows reserved device name
nul

# local tooling
/.claude/
